<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EBE0"
    tools:context=".Message.tutorial.Tutorial1Fragment">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageViewTutorial"
            android:layout_width="240dp" android:layout_height="240dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Welcome Logo"
            android:src="@drawable/welcome_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang"
            android:textColor="#4E3D30"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ini adalah halaman tutor 1. Mulai petualangan estetikmu dengan panduan mudah di aplikasi ini."
            android:textColor="#7A6855"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</FrameLayout>