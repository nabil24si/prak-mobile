<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EBE0"
    tools:context=".Message.tutorial.Tutorial2Fragment">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageViewTutorial2"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="Explore Illustration"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="#A3B19B" />

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jelajahi Fitur"
        android:textColor="#4E3D30"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ini adalah halaman tutor 2. Temukan berbagai kemudahan dan fitur menarik yang dirancang khusus untuk Anda."
            android:textColor="#7A6855"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</FrameLayout>